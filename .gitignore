
# graphify-axet
.graphify/
# deps + build output
node_modules/
apps/*/node_modules/
packages/*/node_modules/
apps/*/dist/
packages/*/dist/
# scratch dir for validating the container layout locally
.dockersim/
# local runtime data (sqlite, uploads, mail outbox) — never commit
# ponytail: root-scoped — a bare "data/" also swallows apps/*/src/data (reference tables)
/data/
*.db
*.db-shm
*.db-wal
# secrets + logs
.env
.env.*
*.log
outbox.json
